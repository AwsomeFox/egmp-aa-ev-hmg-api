{
  "id": "egmp-aa-ev",
  "name": "EV routing for Android Auto (E-GMP)",
  "version": "0.7.0",
  "hmgapi": ">=1.0.0",
  "authors": [
    "willemcvu",
    "AwsomeFox"
  ],
  "license": "AGPL-3.0",
  "description": "Needs HMG-API's Wireless CarPlay + Android Auto mod. Google Maps EV routing over Android Auto: battery and range, charge curves, EV plugs, battery preconditioning for DC chargers.",
  "requires": ["wireless-carplay-aa >=2.1.0"],
  "system": {
    "model": ["NEEV", "NEEV23", "NEEV23SE", "CVEV", "CEEV"]
  },
  "hooks": {
    "jar": "hooks.jar",
    "entry": "com.google.android.projection.protocol.HmgApiEntry",
    "points": {
      "gpm.sensor_source.init": "change",
      "gpm.receiver.destroy": "observe",
      "gpm.receiver_service.disconnected": "observe",
      "gpm.navigation_status.next_turn": "observe",
      "gpm.navigation_status.status": "observe"
    },
    "native": {
      "libautoreceiver_infobank.so": [
        "recipes/ev-sensor-48ee793a.recipe",
        "recipes/ev-sensor-dbfe7bd2.recipe"
      ]
    }
  },
  "projection": {
    "aa_fuel_types": [10],
    "aa_ev_connectors": [4, 1]
  },
  "vehicle": {
    "commands": ["conditioning"]
  },
  "usb": ["egmp-aa-ev-logs"],
  "services": [
    {
      "name": "relay",
      "jar": "relay.jar",
      "class": "dev.egmp.aaev.RelayService",
      "user": "system"
    },
    {
      "name": "offload",
      "script": "scripts/offload.sh",
      "user": "root"
    }
  ],
  "logs": {
    "tags": ["EvModelSender", "EvDriveLog", "EvLogger", "EvCar", "EvPrecond"],
    "match": ["[egmp-aa-ev]"]
  }
}
